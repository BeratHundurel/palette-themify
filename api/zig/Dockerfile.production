FROM alpine:3.23 AS build

ARG ZIG_VERSION=0.16.0
RUN apk add --no-cache curl xz tar build-base libc-dev \
    && curl -L "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" -o /tmp/zig.tar.xz \
    && mkdir -p /opt/zig \
    && tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1 \
    && rm /tmp/zig.tar.xz
ENV PATH="/opt/zig:${PATH}"
WORKDIR /src
COPY . .
RUN zig build --cache-dir /tmp/zig-local-cache --global-cache-dir /tmp/zig-global-cache

FROM alpine:3.23
RUN addgroup -S themesmith && adduser -S -G themesmith themesmith
COPY --from=build /src/zig-out/bin/palette_themify_api /usr/local/bin/palette_themify_api
USER themesmith
EXPOSE 8089
ENTRYPOINT ["palette_themify_api"]
