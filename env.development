# Runtime mode
APP_ENV=development
APP_VERSION=dev

# Published development ports
POSTGRES_PORT=5433
GO_API_PORT=8088
ZIG_API_PORT=8089
FRONTEND_PORT=5173
JAEGER_UI_PORT=16686
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=themesmith
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=themesmith
DB_SSL_MODE=disable
DB_LOG_LEVEL=warn

# Browser/API routing and CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://wails.localhost:9245
VITE_API_BASE_URL=http://localhost:8088
VITE_ZIG_API_BASE_URL=http://localhost:8089
ZIG_ALLOWED_ORIGIN=*
MAX_BODY_SIZE_MB=50

# Authentication
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8088/auth/google/callback

# OpenTelemetry. The observability Compose overlay fills the endpoint automatically.
OTEL_SERVICE_NAME=themesmith-api
OTEL_EXPORTER_OTLP_ENDPOINT=
VITE_TELEMETRY_ENABLED=false
